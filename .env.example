# ============================================
# 播客自动化系统配置 - Podcast Automation System
# ============================================

# --- 数据库配置 ---
DATABASE_URL=sqlite+aiosqlite:///./data/podcast.db

# --- OpenAI API 配置 ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4
WHISPER_MODEL=whisper-1

# --- iTunes API ---
ITUNES_API_ENABLED=true

# --- Spotify API (可选) ---
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# --- 调度配置 ---
# Cron 表达式: 每日北京时间 23:00 执行
SCHEDULER_CRON_HOUR=23
SCHEDULER_CRON_MINUTE=0
SCHEDULER_TIMEZONE=Asia/Shanghai

# --- 处理配置 ---
MAX_CONCURRENT_FEEDS=5
INCREMENTAL_UPDATE_HOURS=24
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_BASE=2

# --- 存储配置 ---
SUMMARIES_DIR=./summaries
AUDIO_TEMP_DIR=./temp/audio
LOG_DIR=./logs

# --- 服务配置 ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DEBUG=false

# --- 内存监控 ---
MEMORY_LIMIT_MB=1024
MEMORY_CHECK_INTERVAL=60
